[Unit]
Description=Block P sign server (playback, lights, controls)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/blockp/app
ExecStart=/home/pi/blockp/venv/bin/python server.py
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
# Port 80, so phones can just open http://blockp.local
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
